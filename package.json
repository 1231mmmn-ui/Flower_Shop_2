{
  "name": "flower-shop-hanasaku",
  "private": true,
  "version": "1.0.0",
  "description": "Flower Shop ～花咲く時間～ — 誰かを想いながら花を選ぶ時間を楽しむゲーム",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:one": "npm run build && python3 tools/build_single_file.py",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "assets": "python3 tools/generate_placeholder_assets.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
